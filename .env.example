# Public URL encoded in the QR code printed on product packaging.
#
# Development (optional):
#   Leave unset — the in-app QR uses your current browser URL.
#   For phone testing on Wi-Fi, use your computer's LAN IP:
#   VITE_SITE_URL=http://192.168.1.100:5173
#
# Production (required before deploy):
VITE_SITE_URL=https://qr-scan-drab.vercel.app/
